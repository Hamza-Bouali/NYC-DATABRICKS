{
  "datasets": [
    {
      "name": "ds_hourly_demand",
      "displayName": "Hourly demand",
      "query": "SELECT\n  pickup_hour,\n  pickup_borough,\n  COUNT(*) AS trip_count,\n  ROUND(AVG(total_amount), 2) AS avg_fare\nFROM nyc_taxi.gold.trip_summary\nWHERE trip_date >= (SELECT MAX(trip_date) - INTERVAL 6 DAYS FROM nyc_taxi.gold.trip_summary)\nGROUP BY pickup_hour, pickup_borough\nORDER BY pickup_hour, pickup_borough"
    },
    {
      "name": "ds_underserved_zones",
      "displayName": "Underserved zones",
      "query": "SELECT\n  pickup_borough,\n  pickup_zone,\n  COUNT(*) AS trips_latest_day\nFROM nyc_taxi.gold.trip_summary\nWHERE trip_date >= (SELECT MAX(trip_date) - INTERVAL 60 DAYS FROM nyc_taxi.gold.trip_summary)\nGROUP BY pickup_borough, pickup_zone\nHAVING COUNT(*) < 100\nORDER BY trips_latest_day ASC\nLIMIT 10"
    },
    {
      "name": "ds_zone_saturation",
      "displayName": "Zone saturation",
      "query": "WITH zone_counts AS (\n  SELECT\n    trip_date,\n    pickup_borough,\n    pickup_zone,\n    COUNT(*) AS trip_count_per_zone\n  FROM nyc_taxi.gold.trip_summary\n  WHERE trip_date >= (SELECT MAX(trip_date) - INTERVAL 13 DAYS FROM nyc_taxi.gold.trip_summary)\n  GROUP BY trip_date, pickup_borough, pickup_zone\n)\nSELECT\n  trip_date,\n  pickup_borough,\n  COUNT(DISTINCT pickup_zone) AS zones_active,\n  SUM(CASE WHEN trip_count_per_zone > 100 THEN 1 ELSE 0 END) AS saturated_zones\nFROM zone_counts\nGROUP BY trip_date, pickup_borough\nORDER BY trip_date DESC, pickup_borough"
    }
  ],
  "pages": [
    {
      "name": "fleet_operations",
      "displayName": "Fleet Operations",
      "layout": [
        {
          "widget": {
            "name": "text_header",
            "textbox_spec": "# Fleet Operations\n\nUse the latest available 7-14 days of demand and saturation signals to redirect vehicles toward underserved zones."
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "demand_heatmap",
            "displayName": "",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_hourly_demand",
                  "fields": [
                    {"name": "pickup_hour", "expression": "`pickup_hour`"},
                    {"name": "pickup_borough", "expression": "`pickup_borough`"},
                    {"name": "trip_count", "expression": "`trip_count`"},
                    {"name": "avg_fare", "expression": "`avg_fare`"}
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "heatmap",
              "encodings": {
                "x": {
                  "fieldName": "pickup_hour",
                  "scale": {"type": "categorical"},
                  "axis": {"hideTitle": true}
                },
                "y": {
                  "fieldName": "pickup_borough",
                  "scale": {"type": "categorical"},
                  "axis": {"hideTitle": true}
                },
                "color": {
                  "fieldName": "trip_count",
                  "scale": {
                    "type": "quantitative",
                    "colorRamp": {
                      "mode": "scheme",
                      "scheme": "viridis"
                    }
                  }
                }
              },
              "frame": {
                "title": "Hourly demand by borough",
                "showTitle": true,
                "description": "Trip count intensity over the latest available 7 days",
                "showDescription": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 6,
            "height": 4
          }
        },
        {
          "widget": {
            "name": "underserved_bar",
            "displayName": "",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_underserved_zones",
                  "fields": [
                    {"name": "pickup_borough", "expression": "`pickup_borough`"},
                    {"name": "pickup_zone", "expression": "`pickup_zone`"},
                    {"name": "trips_latest_day", "expression": "`trips_latest_day`"}
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "trips_latest_day",
                  "scale": {"type": "quantitative"}
                },
                "y": {
                  "fieldName": "pickup_zone",
                  "scale": {"type": "categorical"}
                },
                "color": {
                  "fieldName": "pickup_borough",
                  "scale": {"type": "categorical"}
                }
              },
              "frame": {
                "title": "Top 10 underserved zones on latest available day",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 6,
            "width": 3,
            "height": 4
          }
        },
        {
          "widget": {
            "name": "saturation_area",
            "displayName": "",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_zone_saturation",
                  "fields": [
                    {"name": "trip_date", "expression": "`trip_date`"},
                    {"name": "zones_active", "expression": "`zones_active`"},
                    {"name": "saturated_zones", "expression": "`saturated_zones`"}
                  ]
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Zone saturation timeline"
              },
              "version": 3,
              "widgetType": "area",
              "encodings": {
                "x": {
                  "fieldName": "trip_date",
                  "scale": {"type": "temporal"}
                },
                "y": {
                  "fields": [
                    {
                      "fieldName": "zones_active",
                      "displayName": "Active zones"
                    },
                    {
                      "fieldName": "saturated_zones",
                      "displayName": "Saturated zones"
                    }
                  ],
                  "scale": {"type": "quantitative"}
                },
                "color": {}
              },
              "data": {"queryName": "main_query"}
            }
          },
          "position": {
            "x": 3,
            "y": 6,
            "width": 3,
            "height": 4
          }
        }
      ]
    }
  ]
}
