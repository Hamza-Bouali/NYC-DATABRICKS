{
  "datasets": [
    {
      "name": "ds_daily_revenue",
      "displayName": "Daily revenue",
      "query": "SELECT\n  trip_date,\n  pickup_borough AS borough,\n  ROUND(SUM(total_amount), 2) AS daily_revenue,\n  COUNT(*) AS trip_count,\n  ROUND(AVG(tip_percentage), 2) AS avg_tip_pct\nFROM\n  nyc_taxi.gold.trip_summary\nWHERE\n  trip_date >= (\n    SELECT MAX(trip_date) - INTERVAL 29 DAYS\n    FROM nyc_taxi.gold.trip_summary\n  )\nGROUP BY\n  trip_date,\n  pickup_borough\nORDER BY\n  trip_date DESC,\n  daily_revenue DESC"
    },
    {
      "name": "ds_revenue_per_trip",
      "displayName": "Revenue per trip",
      "query": "SELECT \n  DATE_TRUNC('WEEK', trip_date) AS week_start,\n  pickup_borough,\n  ROUND(SUM(total_amount) / COUNT(*), 2) AS revenue_per_trip,\n  ROUND(AVG(trip_distance), 2) AS avg_distance\nFROM nyc_taxi.gold.trip_summary\nWHERE trip_date >= (SELECT MAX(trip_date) - INTERVAL 89 DAYS FROM nyc_taxi.gold.trip_summary)\nGROUP BY DATE_TRUNC('WEEK', trip_date), pickup_borough\nORDER BY week_start DESC, pickup_borough"
    },
    {
      "name": "ds_fare_anomalies",
      "displayName": "Fare anomalies",
      "query": "SELECT\n  trip_date,\n  pickup_borough,\n  anomaly_flag,\n  COUNT(*) AS flagged_trips,\n  ROUND(SUM(total_amount), 2) AS flagged_revenue\nFROM\n  nyc_taxi.gold.trip_summary\nWHERE\n  trip_date >= (\n    SELECT MAX(trip_date) - INTERVAL 30 DAYS\n    FROM nyc_taxi.gold.trip_summary\n  )\nGROUP BY\n  trip_date,\n  pickup_borough,\n  anomaly_flag\nORDER BY\n  trip_date DESC,\n  flagged_trips DESC"
    }
  ],
  "pages": [
    {
      "name": "financial_performance",
      "displayName": "Financial Performance",
      "layout": [
        {
          "widget": {
            "name": "text_header",
            "textbox_spec": "# Financial Performance\n\nTrack borough revenue, unit economics, tip trends, and fare anomalies for finance and executive reviews."
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "daily_revenue_line",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_revenue",
                  "fields": [
                    {"name": "trip_date", "expression": "`trip_date`"},
                    {"name": "borough", "expression": "`borough`"},
                    {"name": "daily_revenue", "expression": "`daily_revenue`"},
                    {"name": "trip_count", "expression": "`trip_count`"},
                    {"name": "avg_tip_pct", "expression": "`avg_tip_pct`"}
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "trip_date",
                  "scale": {"type": "temporal"}
                },
                "y": {
                  "fieldName": "daily_revenue",
                  "scale": {"type": "quantitative"},
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact"
                  }
                },
                "color": {
                  "fieldName": "borough",
                  "scale": {"type": "categorical"}
                }
              },
              "frame": {
                "title": "Daily revenue by borough",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 3,
            "height": 4
          }
        },
        {
          "widget": {
            "name": "revenue_per_trip_combo",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_revenue_per_trip",
                  "fields": [
                    {"name": "week_start", "expression": "`week_start`"},
                    {"name": "revenue_per_trip", "expression": "`revenue_per_trip`"},
                    {"name": "avg_distance", "expression": "`avg_distance`"}
                  ]
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Revenue per trip and average distance"
              },
              "version": 1,
              "widgetType": "combo",
              "encodings": {
                "x": {
                  "fieldName": "week_start",
                  "scale": {"type": "temporal"}
                },
                "y": {
                  "primary": {
                    "fields": [
                      {
                        "fieldName": "revenue_per_trip",
                        "displayName": "Revenue per trip ($)"
                      }
                    ],
                    "scale": {"type": "quantitative"}
                  },
                  "secondary": {
                    "fields": [
                      {
                        "fieldName": "avg_distance",
                        "displayName": "Average distance (mi)"
                      }
                    ],
                    "scale": {"type": "quantitative"}
                  }
                }
              },
              "data": {"queryName": "main_query"}
            }
          },
          "position": {
            "x": 3,
            "y": 2,
            "width": 3,
            "height": 4
          }
        },
        {
          "widget": {
            "name": "anomaly_alerts_bar",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_fare_anomalies",
                  "fields": [
                    {"name": "trip_date", "expression": "`trip_date`"},
                    {"name": "pickup_borough", "expression": "`pickup_borough`"},
                    {"name": "anomaly_flag", "expression": "`anomaly_flag`"},
                    {"name": "flagged_trips", "expression": "`flagged_trips`"},
                    {"name": "flagged_revenue", "expression": "`flagged_revenue`"}
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "trip_date",
                  "scale": {"type": "temporal"}
                },
                "y": {
                  "fieldName": "flagged_trips",
                  "scale": {"type": "quantitative"}
                },
                "color": {
                  "fieldName": "anomaly_flag",
                  "scale": {
                    "type": "categorical",
                    "mappings": [
                      {"value": "EXTREME_DISTANCE", "color": "#DC6B3F"},
                      {"value": "EXTREME_FARE", "color": "#F59E0B"}
                    ]
                  }
                }
              },
              "frame": {
                "title": "Fare anomaly alerts",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 6,
            "width": 6,
            "height": 4
          }
        }
      ]
    }
  ]
}
